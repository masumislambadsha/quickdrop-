# ============================================================
# QuickDrop — Production environment template (for Vercel)
# Copy values into Vercel > Project > Settings > Environment Variables
# ============================================================

# ---- Server ----
NODE_ENV=production
PORT=3000
# The deployed Vercel URL, e.g. https://quickdrop-xxxx.vercel.app
BACKEND_URL=https://quickdrop-xxxx.vercel.app
# Client origin used for CORS + Stripe success/cancel redirects
FRONTEND_URL=http://localhost:3000

# ---- Database (Prisma Postgres) ----
# Use the pooled connection string from Prisma Postgres.
DATABASE_URL="postgres://USER:PASSWORD@POOLED.db.prisma.io:5432/postgres?sslmode=require"

# ---- JWT ----
# Use unique, long random strings in production.
JWT_ACCESS_SECRET=change_me_production_access_secret
JWT_REFRESH_SECRET=change_me_production_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Stripe (test or live) ----
STRIPE_SECRET_KEY=sk_test_xxx_yyy
# IMPORTANT: this must be a WEBHOOK SIGNING SECRET starting with `whsec_`,
# NOT a publishable `pk_test_...` key. Get it from Stripe Dashboard >
# Developers > Webhooks > your endpoint > "Retrieve signing secret".
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# ---- GCP / Google OAuth ----
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
# Use the deployed callback URL so Google OAuth resolves.
GOOGLE_REDIRECT_URI=https://quickdrop-xxxx.vercel.app/api/v1/auth/google/callback

# ---- Redis (optional; caching for dashboard stats) ----
# Provide an Upstash / Vercel KV REST URL if you want caching.
# Leave empty to degrade gracefully.
REDIS_URL=