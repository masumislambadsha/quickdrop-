{
    "name": "quickdrop-backend",
    "version": "1.0.0",
    "description": "QuickDrop — Courier & Logistics Platform Backend",
    "main": "dist/src/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "build:vercel": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
        "start": "tsx src/server.ts",
        "postinstall": "prisma generate",
        "test": "echo \"Error: no test specified\" && exit 1",
        "format:check": "npx @biomejs/biome format ./src",
        "format:fix": "npx @biomejs/biome format --write ./src",
        "lint:check": "npx @biomejs/biome lint ./src",
        "lint:fix": "npx @biomejs/biome lint --write ./src",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "keywords": [
        "courier",
        "logistics",
        "shipping",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "google-auth-library": "^11.0.0",
        "helmet": "^8.1.0",
        "http-status": "^2.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.22.0",
        "redis": "^6.2.0",
        "stripe": "^22.6.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "esbuild": "^0.28.2",
        "@biomejs/biome": "2.5.7",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.0",
        "prisma": "^7.10.0",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "prisma@7.10.0": true,
        "@prisma/engines@7.10.0": true,
        "esbuild@0.28.2": true
    }
}
