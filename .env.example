# ===== Server =====
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ===== Database =====
# PostgreSQL / Prisma Postgres connection string
DATABASE_URL="postgres://USER:PASSWORD@POOLED.db.prisma.io:5432/postgres?sslmode=require"

# ===== JWT =====
JWT_ACCESS_SECRET=change_me_access_secret_use_a_long_random_string
JWT_REFRESH_SECRET=change_me_refresh_secret_use_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ===== Stripe (test mode) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ===== GCP / Google OAuth =====
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# ===== Redis (caching, optional for local dev) =====
REDIS_URL=
